	measure CVMC =
			VAR __PREV_MONTH = CALCULATE([Couts], DATEADD('DimDates'[Date], -1, MONTH))
			VAR _Perc= DIVIDE([Couts] - __PREV_MONTH, __PREV_MONTH)
			RETURN
				IF(_Perc>=0,  "Green","Red")
		displayFolder: Couleurs des variations mensuels
		lineageTag: e6da3dac-7106-49ee-8d80-555e82bb0fb6

