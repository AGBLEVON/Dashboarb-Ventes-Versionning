		annotation SummarizationSetBy = Automatic

	partition DimDates = calculated
		mode: import
		source = ```
				
				
				VAR DateDebut = MIN(FaitVentes[Date])
				
				VAR DateFin = MAX(FaitVentes[Date])
				
				RETURN 
				
				ADDCOLUMNS(CALENDAR(DateDebut, DateFin),
				
				"Année", FORMAT([Date], "yyyy"),
				
				"NoMois", MONTH([Date]),
				
				"Mois", FORMAT([Date],"MMMM"),
				
				"JourMois", FORMAT([Date], "dd") & " - " & FORMAT([Date],"MMM"),
				
				"Trimestre", FORMAT([Date],"Tri\m Q"),
				
				"AnneeMois", FORMAT([Date],"YYYY-MM"),
				
				"NoJourSemaine", WEEKDAY([Date],2), //1-Dim..Sam; 2-Lun..Sam
				
				"JourSemaine", FORMAT([Date],"ddd"),
				
				"NoSemaine", WEEKNUM([Date], 2),
				
				"Semaine", "S" & WEEKNUM([Date], 2) )
				```

	annotation PBI_Id = c66c54e9acbf48b4a2885c5aab995119

